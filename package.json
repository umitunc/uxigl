{
  "name": "truncgil-uxigl",
  "version": "2.7.0",
  "description": "uxiGL — Liquid Glass & Google Material You Modular Design System with SheetGL DataGrid, FileManGL VFS & Interactive Analytics Charts",
  "license": "MIT",
  "author": "Trunçgil Teknoloji (https://www.truncgil.com)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/umitunc/uxigl.git"
  },
  "bugs": {
    "url": "https://github.com/umitunc/uxigl/issues"
  },
  "homepage": "https://github.com/umitunc/uxigl#readme",
  "keywords": [
    "uxigl",
    "design-system",
    "liquid-glass",
    "material-3",
    "material-you",
    "sheetgl",
    "filemangl",
    "webgl",
    "datagrid",
    "analytics-dashboard",
    "ui-components"
  ],
  "type": "module",
  "bin": {
    "truncgil-uxigl": "bin/cli.mjs",
    "uxigl": "bin/cli.mjs",
    "create-uxigl": "bin/cli.mjs"
  },
  "main": "./dist/lib/uxigl.cjs",
  "module": "./dist/lib/uxigl.js",
  "types": "./dist/lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/lib/types/index.d.ts",
      "import": "./dist/lib/uxigl.js",
      "require": "./dist/lib/uxigl.cjs"
    },
    "./styles": "./dist/lib/style.css",
    "./style.css": "./dist/lib/style.css",
    "./uxu-tokens.css": "./dist/lib/style.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist/lib",
    "bin",
    "README.md",
    "docs"
  ],
  "scripts": {
    "dev": "vite",
    "build:demo": "tsc -b && vite build",
    "build:lib": "tsc -p tsconfig.lib.json && vite build --config vite.lib.config.ts",
    "build": "npm run build:demo && npm run build:lib",
    "prepublishOnly": "npm run build:lib",
    "cli": "node ./bin/cli.mjs",
    "doctor": "node ./bin/cli.mjs doctor",
    "pack:check": "npm pack --dry-run",
    "preview": "vite preview"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "dependencies": {
    "filemangl": "^1.0.5",
    "lucide-react": "^1.16.0",
    "sheetgl": "^2.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "~5.7.2",
    "vite": "^6.2.0"
  }
}
